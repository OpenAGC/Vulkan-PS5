#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform usampler2D sampled_image;
layout(std430, set = 0, binding = 1) buffer Results {
    uvec4 values[];
} results;
layout(push_constant) uniform PushConstants {
    uint index;
} pc;

void main()
{
    results.values[pc.index] = texelFetch(sampled_image, ivec2(0), 0);
}
