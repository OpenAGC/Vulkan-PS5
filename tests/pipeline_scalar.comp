#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(set = 1, binding = 3, scalar) buffer ScalarData {
    vec3 value;
    float result;
} data;

layout(set = 1, binding = 4, std430) uniform StandardUniformData {
    float weights[2];
} standard_data;

void main()
{
    data.result = data.value.x + standard_data.weights[1];
}
