#version 450

layout(local_size_x = 4, local_size_y = 2, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Output {
    uint values[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    uint addend;
} push_constants;

void main()
{
    output_buffer.values[gl_GlobalInvocationID.x] =
        gl_GlobalInvocationID.x + push_constants.addend;
}
