#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Destination {
    uint words[];
} destination;

layout(push_constant) uniform ClearParameters {
    uvec4 pattern;
    uint word_count;
    uint pattern_word_count;
    uint destination_word_offset;
    uint layer_word_stride;
} parameters;

void main()
{
    uint first_word = gl_GlobalInvocationID.x * 4u;
    for (uint index = 0u; index < 4u; ++index) {
        uint word = first_word + index;
        if (word < parameters.word_count)
            destination.words[parameters.destination_word_offset +
                gl_GlobalInvocationID.y * parameters.layer_word_stride +
                word] =
                parameters.pattern[word % parameters.pattern_word_count];
    }
}
